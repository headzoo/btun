# Copy to apps/mobile/.env.local and fill from Firebase Console → Project settings.
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET is required for binary files and text > 10,000 characters.
# Inline UTF-8 text (≤ 10k chars, no NUL) syncs through RTDB alone.
# Safe rules rollout: see root README.md § Firebase rules deployment.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
