# Copy to apps/desktop/.env.local and fill from Firebase Console → Project settings.
# VITE_FIREBASE_STORAGE_BUCKET is required for binary files and text > 10,000 characters.
# Inline UTF-8 text (≤ 10k chars, no NUL) syncs through RTDB alone.
# Safe rules rollout: see root README.md § Firebase rules deployment.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
